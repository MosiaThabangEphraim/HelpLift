NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. From Supabase Dashboard > Project Settings > API > service_role key.
# Required for admin password resets (api/admin/users/[id]/route.ts). Never expose
# this to the client or prefix it with NEXT_PUBLIC_ — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Used by lib/mailer.ts for the "Partner with us" contact form
# (api/contact/route.ts) and the notification-email webhook
# (api/webhooks/notification-created). This calls Brevo's transactional email
# HTTP API directly (https://api.brevo.com/v3/smtp/email) rather than SMTP —
# SMTP (ports 587/465) is commonly blocked outbound on ISPs/campus networks
# and some hosting platforms, while the HTTP API just uses normal HTTPS.
# This is separate from the Supabase Auth SMTP config (Dashboard > Project
# Settings > Auth > SMTP Settings), which only sends Supabase's own fixed
# auth emails and is unaffected by anything here.
# Get an API key from Brevo Dashboard > SMTP & API > API Keys (not the SMTP
# tab — that's a different kind of key).
BREVO_API_KEY=your-brevo-api-key
# Must be a sender address verified in Brevo (Senders, domains, IPs).
SMTP_FROM=HelpLift <no-reply@yourdomain.com>
# Where contact form submissions are delivered.
CONTACT_EMAIL_TO=admin@yourdomain.com

# Public base URL of this app, used to build PayFast's return/cancel/notify
# URLs (api/giver/donations POST) and the email verification redirect
# (api/register). Falls back to the request's own origin when unset, but set
# this explicitly when testing PayFast locally via a tunnel (see below) —
# PayFast must be able to reach notify_url from the internet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PayFast (lib/payfast.ts, api/giver/donations, api/public/payfast/notify).
# Sandbox: use https://sandbox.payfast.co.za/eng/process and the merchant
# id/key/passphrase from your sandbox account at sandbox.payfast.co.za.
# Live: switch PAYFAST_URL to https://www.payfast.co.za/eng/process and use
# your live merchant details. The ITN webhook (notify_url) must be publicly
# reachable — use a tool like ngrok for local sandbox testing and set
# NEXT_PUBLIC_SITE_URL above to that tunnel's https URL.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process

# Shared secret checked by api/webhooks/notification-created against the
# x-webhook-secret header Supabase sends. Set this to any random string, then
# enter the SAME value as a custom header when creating the Database Webhook
# in Supabase Dashboard > Database > Webhooks (table: notifications, event:
# Insert, URL: <NEXT_PUBLIC_SITE_URL>/api/webhooks/notification-created).
# Sends via the same BREVO_API_KEY used by api/contact.
NOTIFICATION_WEBHOOK_SECRET=your-random-secret

# Google sign-in ("Continue with Google").
# Google sign-in runs through Supabase Auth, so the app code does not read these two
# values: paste the SAME client ID and secret into the Supabase dashboard under
# Authentication > Sign In / Providers > Google, and add this redirect URI in Google
# Cloud Console: https://<your-project-ref>.supabase.co/auth/v1/callback
# They are kept here so the credentials live in one documented place.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
